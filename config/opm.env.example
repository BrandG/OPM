# OPM email credentials — TEMPLATE (safe to commit; contains no secrets).
#
# The daily digest emailer reads SMTP creds from the ENVIRONMENT, never from the
# repo. To enable email:
#
#   1. Turn on 2-Step Verification on your Google account, then generate an
#      "App password": https://myaccount.google.com/apppasswords
#      (NOT your normal Gmail password — a 16-char app-specific one.)
#
#   2a. Linux/macOS: copy this file and fill it in, then lock it down:
#          cp config/opm.env.example ~/.config/opm.env
#          chmod 600 ~/.config/opm.env
#       run_cycle.sh sources ~/.config/opm.env automatically.
#
#   2b. Windows: set these as USER environment variables (so the Task Scheduler
#       job inherits them), e.g. in PowerShell:
#          setx OPM_SMTP_USER "you@gmail.com"
#          setx OPM_SMTP_PASSWORD "your16charapppw"
#       (No opm.env file needed; run_cycle.ps1 reads them from the environment.)
#
#   3. In config.yaml set email.enabled: true and your to_addrs.
#
# The var names below must match config.yaml's email.user_env / password_env.

OPM_SMTP_USER=you@gmail.com
OPM_SMTP_PASSWORD=your16charapppassword
